{
  "name": "vs-office-lite",
  "displayName": "VS Office - Lightweight Editor",
  "icon": "assets/vs-office-icon.png",
  "description": "Review and make focused edits to DOCX, PPTX and XLSX files in VS Code with conservative OOXML saving.",
  "version": "0.5.0",
  "publisher": "tetsuji16",
  "license": "MIT",
  "sponsor": {
    "url": "https://github.com/sponsors/tetsuji16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetsuji16/vs-office.git"
  },
  "homepage": "https://github.com/tetsuji16/vs-office#readme",
  "bugs": {
    "url": "https://github.com/tetsuji16/vs-office/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "galleryBanner": {
    "color": "#07152f",
    "theme": "dark"
  },
  "keywords": [
    "office",
    "docx",
    "pptx",
    "xlsx",
    "word",
    "powerpoint",
    "excel",
    "viewer",
    "editor",
    "ooxml"
  ],
  "activationEvents": [
    "onCustomEditor:vsOffice.editor"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vsOffice.editor",
        "displayName": "VS Office",
        "selector": [
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.pptx"
          },
          {
            "filenamePattern": "*.xlsx"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "vsOffice.openOfficeFile",
        "title": "VS Office: Open Office File"
      }
    ],
    "configuration": {
      "title": "VS Office",
      "properties": {
        "vsOffice.createBackupOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Create a recoverable copy in .vs-office-backups before overwriting an Office file."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check && npm test",
    "test": "node --test",
    "check": "node --check extension.js && node --check src/office-package.js"
  },
  "dependencies": {
    "docx-preview": "^0.3.7",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "jsdom": "^24.0.0"
  }
}
